# VisCreate 环境变量配置示例
# 复制此文件为 .env 并填入你的API密钥

# OpenAI配置（必需）
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# 视频生成API配置
# 提供商: happyhorse (阿里云百炼), seedance (字节跳动火山引擎)
VIDEO_PROVIDER=happyhorse
VIDEO_API_KEY=your_video_api_key_here
# API端点（可选，留空使用默认值）
# HappyHorse默认: https://dashscope.aliyuncs.com
# Seedance默认: https://ark.cn-beijing.volces.com
VIDEO_API_ENDPOINT=
VIDEO_MODEL=happyhorse-1.0-t2v

# Stability AI配置（可选）
STABILITY_API_KEY=your_stability_api_key_here

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vis-create
DB_USER=postgres
DB_PASSWORD=your_password_here

# MinIO对象存储配置
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=vis-create
MINIO_SECURE=false

# 应用配置
OUTPUT_DIR=./output
VERBOSE=false
LOG_LEVEL=INFO
