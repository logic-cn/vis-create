# VisCreate 环境变量配置示例
# 复制此文件为 .env 并填入你自己的配置。
#
# ⚠️ 安全提示：.env 已被 .gitignore 忽略。请勿把真实密钥写入本示例文件，
#    也不要提交 .env —— 所有值都必须是占位符。详见 SECURITY.md。

# OpenAI配置（必需）
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# 视频生成API配置
# 提供商: happyhorse (阿里云百炼), seedance (字节跳动火山引擎)
VIDEO_PROVIDER=happyhorse
VIDEO_API_KEY=your_video_api_key_here
# API端点（可选，留空使用默认值）
# HappyHorse默认: https://dashscope.aliyuncs.com
# Seedance默认: https://ark.cn-beijing.volces.com
VIDEO_API_ENDPOINT=
VIDEO_MODEL=happyhorse-1.0-t2v

# Stability AI配置（可选）
STABILITY_API_KEY=your_stability_api_key_here

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vis-create
DB_USER=postgres
DB_PASSWORD=your_password_here

# MinIO对象存储配置
# 本地 MinIO 默认凭据为 minioadmin/minioadmin，仅用于本地开发，请按需替换。
#
# ⚠️ 桌面端 CSP 须知：Tauri 的 img-src / media-src 已放行回环地址的任意端口
#    （http://localhost:* 与 http://127.0.0.1:*），所以保持默认的
#    127.0.0.1:9000 可直接在画廊中显示图片/视频。
#    若你把 MINIO_ENDPOINT 改成非回环地址（例如 192.168.1.10:9000 或 https://oss.example.com），
#    必须同步把该主机加入 gui/src-tauri/tauri.conf.json 的 img-src 与 media-src，
#    否则图片会被 CSP 拦截、画廊显示空白。
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=your_minio_access_key_here
MINIO_SECRET_KEY=your_minio_secret_key_here
MINIO_BUCKET=vis-create
MINIO_SECURE=false

# 应用配置
OUTPUT_DIR=./output
VERBOSE=false
LOG_LEVEL=INFO

# 跨域来源白名单（可选，逗号分隔）
# 留空时仅允许本地前端来源：
#   http://localhost:1420, http://127.0.0.1:1420, tauri://localhost, http://tauri.localhost
# 注意：不支持 "*"
# CORS_ALLOW_ORIGINS=http://localhost:1420,tauri://localhost
