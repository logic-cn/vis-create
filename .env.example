# VisCreate 环境变量配置示例
# 复制此文件为 .env 并填入你的API密钥

# OpenAI配置（必需）
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# 视频生成API配置（可选，根据你使用的服务）
VIDEO_API_KEY=your_video_api_key_here
VIDEO_API_ENDPOINT=https://api.runway.com/v1/generate
VIDEO_MODEL=gen-2

# Stability AI配置（可选）
STABILITY_API_KEY=your_stability_api_key_here

# 应用配置
OUTPUT_DIR=./output
VERBOSE=false
LOG_LEVEL=INFO
